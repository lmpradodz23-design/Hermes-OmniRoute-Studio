          "rules": [
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "JWT is decoded without signature verification. jwt.decode() never verifies the signature \u2014 use jwt.verify() with a trusted secret. An empty string secret is effectively no verification."
              },
              "help": {
                "markdown": "JWT is decoded without signature verification. jwt.decode() never verifies the signature \u2014 use jwt.verify() with a trusted secret. An empty string secret is effectively no verification.",
                "text": "JWT is decoded without signature verification. jwt.decode() never verifies the signature \u2014 use jwt.verify() with a trusted secret. An empty string secret is effectively no verification."
              },
              "id": "engine.semgrep.rules.auth.raptor.auth.jwt-no-verify.javascript",
              "name": "engine.semgrep.rules.auth.raptor.auth.jwt-no-verify.javascript",
              "properties": {
                "precision": "very-high",
                "tags": [
                  "CWE-345",
                  "auth",
                  "jwt",
                  "misconfiguration",
                  "security"
                ]
              },
