          "message": {
            "text": "Detected subprocess function 'check_output' with user controlled data. A malicious actor could leverage this to perform command injection. You may consider using 'shlex.escape()'."
          },
          "properties": {},
          "ruleId": "python.lang.security.dangerous-subprocess-use.dangerous-subprocess-use"
