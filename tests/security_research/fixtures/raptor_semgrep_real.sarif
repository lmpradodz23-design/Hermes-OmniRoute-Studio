                  "startLine": 6
                }
              }
            }
          ],
          "message": {
            "text": "Found 'subprocess' function 'check_output' with 'shell=True'. This is dangerous because this call will spawn the command using a shell process. Doing so propagates current shell settings and variables, which makes it much easier for a malicious actor to execute commands. Use 'shell=False' instead."
          },
          "properties": {},
          "ruleId": "python.lang.security.audit.subprocess-shell-true.subprocess-shell-true"
